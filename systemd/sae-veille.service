[Unit]
Description=SAE Veille Technologique - capteur CO2 TTN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/SAE-VeilleTechnologique
EnvironmentFile=/home/pi/SAE-VeilleTechnologique/.env
ExecStart=/home/pi/SAE-VeilleTechnologique/.venv/bin/python /home/pi/SAE-VeilleTechnologique/app.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

# Hardening (compatible with SQLite + log file writes in WorkingDirectory)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/SAE-VeilleTechnologique
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Resource limits suitable for Raspberry Pi
MemoryMax=256M
CPUQuota=80%

[Install]
WantedBy=multi-user.target

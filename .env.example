# --- MQTT (TTN) ---
MQTT_HOST=eu1.cloud.thethings.network
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=capteurco2sensor@ttn
MQTT_PASS=NNSXS.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MQTT_TOPIC=v3/+/devices/+/up

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_THREADS=8

# --- Database ---
DB_PATH=ttn_data.db

# --- Backups ---
BACKUP_DIR=backups
# Interval between backups, in seconds. 21600 = 6 hours.
BACKUP_INTERVAL_SECONDS=21600
# Number of compressed backups to keep (older ones are deleted).
BACKUP_KEEP=30

# --- Logging ---
LOG_FILE=app.log
LOG_LEVEL=INFO
